{
  "name": "@finlytics/ui",
  "version": "0.0.1",
  "private": true,
  "description": "The Finlytics design system: tokens, the Tailwind v4 theme and React 19 components. Ships TypeScript source with no build step; consumers (Next.js, Vite) compile it.",
  "type": "module",
  "engines": {
    "node": ">=24.11"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./globals.css": {
      "types": "./src/styles/stylesheet.d.ts",
      "default": "./src/styles/globals.css"
    },
    "./components/button": "./src/components/button.tsx",
    "./components/card": "./src/components/card.tsx",
    "./components/empty-state": "./src/components/empty-state.tsx",
    "./components/error-state": "./src/components/error-state.tsx",
    "./components/input": "./src/components/input.tsx",
    "./components/page-loader": "./src/components/page-loader.tsx",
    "./components/skeleton": "./src/components/skeleton.tsx",
    "./components/theme-provider": "./src/components/theme-provider.tsx",
    "./components/theme-toggle": "./src/components/theme-toggle.tsx",
    "./lib/theme": "./src/lib/theme.ts",
    "./lib/utils": "./src/lib/utils.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --project unit --project node --coverage",
    "test:storybook": "vitest run --project 'storybook*'",
    "storybook": "storybook dev -p 6006 -h 127.0.0.1 --ci --exact-port",
    "build-storybook": "storybook build -o storybook-static",
    "test:visual": "node scripts/visual.mjs"
  },
  "dependencies": {
    "@finlytics/shared": "workspace:*",
    "@fontsource-variable/inter": "catalog:",
    "@fontsource-variable/jetbrains-mono": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
    "next-themes": "catalog:",
    "radix-ui": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@finlytics/tsconfig": "workspace:*",
    "@playwright/test": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-themes": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "axe-core": "catalog:",
    "jsdom": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-axe": "catalog:"
  }
}
