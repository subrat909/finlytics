{
  "name": "@finlytics/eslint-config",
  "version": "0.0.0",
  "private": true,
  "description": "ESLint flat-config presets (base, library, node, nest, react, next) and the composed restriction sets, used by the repo-root eslint.config.mjs.",
  "type": "module",
  "exports": {
    "./base": "./base.js",
    "./library": "./library.js",
    "./node": "./node.js",
    "./nest": "./nest.js",
    "./next": "./next.js",
    "./react": "./react.js",
    "./restrictions": "./restrictions.js"
  },
  "files": [
    "base.js",
    "library.js",
    "node.js",
    "nest.js",
    "next.js",
    "react.js",
    "restrictions.js"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run"
  },
  "dependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "catalog:",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.0"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "eslint": "^9.39.5",
    "typescript": ">=6.0.3 <6.1.0"
  }
