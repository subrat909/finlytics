{
  "name": "finlytics",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "db:migrate": "pnpm --filter @finlytics/database migrate",
    "db:generate": "pnpm --filter @finlytics/database generate",
    "db:studio": "pnpm --filter @finlytics/database studio",
    "db:seed": "pnpm --filter @finlytics/database seed",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@finlytics/eslint-config": "workspace:*",
    "@finlytics/tsconfig": "workspace:*",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "turbo": "^2.2.3",
    "typescript": "^5.6.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,md,css}": "prettier --write",
    "*.{ts,tsx}": "eslint --fix"
  }
}
