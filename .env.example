# ─── Core ───
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
AI_ENGINE_URL=http://localhost:8000

# ─── Database / cache ───
DATABASE_URL=postgresql://finlytics:finlytics@localhost:5432/finlytics?schema=public&connection_limit=20
DATABASE_DIRECT_URL=postgresql://finlytics:finlytics@localhost:5432/finlytics?schema=public
REDIS_URL=redis://localhost:6379

# ─── Auth.js ───
AUTH_SECRET=change-me-32-bytes-base64
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
EMAIL_SERVER=smtp://localhost:1025
EMAIL_FROM=Finlytics <no-reply@finlytics.local>

# ─── Secrets vault (dev: raw key; prod: KMS) ───
MASTER_KEY=base64-32-bytes-change-me
MASTER_KEY_VERSION=1
SERVICE_JWT_PRIVATE_KEY_PEM=
SERVICE_JWT_PUBLIC_KEY_PEM=

# ─── Brokers (platform app credentials — users never enter these) ───
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:4000/v1/broker-accounts/upstox/callback
DHAN_CLIENT_ID=            # optional platform-level, users paste their own access token

# ─── AI ───
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
NEWS_API_KEY=
LLM_MASTER_MODEL=claude-opus-4-1
LLM_FAST_MODEL=claude-haiku-4-5

# ─── Notifications ───
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
TELEGRAM_BOT_TOKEN=

# ─── Observability ───
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=

# ─── Runtime role for apps/api process: http | gateway | worker | feed-upstox | feed-dhan | all ───
APP_ROLE=all
