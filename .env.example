# ─── Core ───
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
AI_ENGINE_URL=http://localhost:8000

# ─── Database / cache ───
DATABASE_URL=postgresql://finlytics:finlytics@localhost:5432/finlytics?schema=public
DATABASE_DIRECT_URL=postgresql://finlytics:finlytics@localhost:5432/finlytics?schema=public
REDIS_URL=redis://localhost:6379
DB_POOL_MAX=10
# Optional: empty database used by `prisma migrate diff --from-migrations` (drift check). Tests set their own.
# SHADOW_DATABASE_URL=postgresql://finlytics:finlytics@localhost:5432/finlytics_shadow

# ─── Docker host ports (docker compose reads this file; keep DATABASE_URL / REDIS_URL in sync) ───
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# ─── Auth.js ───
AUTH_SECRET=change-me-32-bytes-base64
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
EMAIL_SERVER=smtp://localhost:1025
EMAIL_FROM=Finlytics <no-reply@finlytics.local>

# ─── Secrets vault (dev: raw key; prod: KMS) ───
MASTER_KEY=base64-32-bytes-change-me
MASTER_KEY_VERSION=1
SERVICE_JWT_PRIVATE_KEY_PEM=
SERVICE_JWT_PUBLIC_KEY_PEM=

# ─── Brokers (platform app credentials — users never enter these) ───
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:4000/v1/broker-accounts/upstox/callback
DHAN_CLIENT_ID=            # optional platform-level, users paste their own access token

# ─── AI ───
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
NEWS_API_KEY=
LLM_MASTER_MODEL=claude-opus-4-1
LLM_FAST_MODEL=claude-haiku-4-5

# ─── Notifications ───
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
TELEGRAM_BOT_TOKEN=

# ─── Observability ───
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=

# ─── Runtime role for apps/api process: http | gateway | worker | feed-upstox | feed-dhan | all ───
# apps/api (0.5). Values are development defaults; production rules: docs/04 §7.
APP_ROLE=http
API_HOST=127.0.0.1
API_PORT=4000
API_LOG_LEVEL=info
API_LOG_FORMAT=pretty
# Proxies in front of the api: false, or their comma-separated IPs/CIDRs. Required in production; never true, never a hop count.
API_TRUST_PROXY=false
API_ALLOWED_ORIGINS=http://localhost:3000
API_DOCS_ENABLED=true
API_SHUTDOWN_DRAIN_MS=0
API_RATE_LIMIT_PUBLIC_PER_MIN=100
API_RATE_LIMIT_USER_PER_MIN=600
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000
# DEBUG must stay unset in production (Prisma/ioredis debug output includes query parameters).

