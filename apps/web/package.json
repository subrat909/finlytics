{
  "name": "@finlytics/web",
  "version": "0.0.1",
  "private": true,
  "description": "The Finlytics web app: Next.js 16 App Router, Auth.js v5 database sessions shared with the api, the app shell and the design system from @finlytics/ui.",
  "type": "module",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "dev": "next dev --hostname localhost --port 3000",
    "build": "next build",
    "start": "next start --hostname localhost --port 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@finlytics/database": "workspace:*",
    "@finlytics/shared": "workspace:*",
    "@finlytics/ui": "workspace:*",
    "@fontsource-variable/inter": "catalog:",
    "@fontsource-variable/jetbrains-mono": "catalog:",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-virtual": "^3.14.13",
    "clsx": "catalog:",
    "cmdk": "^1.1.1",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "next-auth": "catalog:",
    "nextjs-toploader": "^3.9.17",
    "nodemailer": "^10.0.15",
    "radix-ui": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.89.0",
    "socket.io-client": "4.8.3",
    "socket.io-msgpack-parser": "^3.0.2",
    "tailwind-merge": "catalog:",
    "zod": "catalog:",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@finlytics/tsconfig": "workspace:*",
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "axe-core": "catalog:",
    "jsdom": "catalog:",
    "playwright": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vitest-axe": "catalog:"
  }
}
