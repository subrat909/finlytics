{
  "name": "@finlytics/api",
  "version": "0.0.1",
  "private": true,
  "description": "The Finlytics HTTP api: NestJS 11 on Fastify 5, configuration validated by Zod, problem+json errors, Prisma and Redis, Auth.js session authentication.",
  "type": "commonjs",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "APP_ROLE=http,gateway,feed,worker node --env-file-if-exists=../../.env --enable-source-maps --watch dist/main.js",
    "dev:compile": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/static": "^10.1.5",
    "@finlytics/broker-sdk": "workspace:*",
    "@finlytics/database": "workspace:*",
    "@finlytics/shared": "workspace:*",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "@nestjs/platform-socket.io": "11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/websockets": "11.2.7",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^6.3.11",
    "fastify": "5.12.5",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.1",
    "nestjs-zod": "^5.5.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "4.8.3",
    "socket.io-msgpack-parser": "^3.0.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@finlytics/tsconfig": "workspace:*",
    "@nestjs/testing": "11.2.7",
    "@testcontainers/postgresql": "catalog:",
    "@testcontainers/redis": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "fast-check": "catalog:",
    "pino-pretty": "^13.2.0",
    "socket.io-client": "4.8.3",
    "testcontainers": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
